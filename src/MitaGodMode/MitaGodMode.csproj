<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>MitaGodMode</AssemblyName>
    <RootNamespace>MitaGodMode</RootNamespace>
    <Version>1.1.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Description>MiSide 作弊模组「无敌与和平」（BepInEx 6 / IL2CPP）——不死 + 怪物不主动攻击 + 移速倍率 + F10 强制跳过追杀环节</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx 6 IL2CPP：来自 nuget.bepinex.dev（见仓库根目录 NuGet.config） -->
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" />
    <!-- HarmonyX：仅编译期引用；运行时由 BepInEx 自带的 0Harmony.dll 提供，不要把输出的 0Harmony.dll 拷进 plugins -->
    <PackageReference Include="HarmonyX" Version="2.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- 可选：环境变量 MISIDE_DIR 指向游戏根目录时，直接引用游戏里的 interop -->
  <PropertyGroup>
    <MiSideDir Condition="'$(MiSideDir)' == '' AND '$(MISIDE_DIR)' != ''">$(MISIDE_DIR)</MiSideDir>
    <LocalInteropDir>$(MSBuildProjectDirectory)\..\..\lib\interop</LocalInteropDir>
  </PropertyGroup>

  <!-- 补丁目标仍全部走字符串反射；但从 v1.1 起热键组件（GodBehaviour）需要
       UnityEngine 包装类型（Input/FindObjectsOfType/SceneManager）→ 引用 interop -->
  <ItemGroup Condition="Exists('$(LocalInteropDir)\Assembly-CSharp.dll')">
    <Reference Include="$(LocalInteropDir)\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(MiSideDir)' != '' AND Exists('$(MiSideDir)\BepInEx\interop\Assembly-CSharp.dll')">
    <Reference Include="$(MiSideDir)\BepInEx\interop\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
